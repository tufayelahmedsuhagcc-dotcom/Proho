# Optional runtime configuration. The app runs with no .env file at all.
# Copy to .env (or export in your shell) only to override a default.

# Port for the Node server. Default: 3000 for `npm start`, 5173 for `npm run dev`.
PORT=3000

# Set to 1 to make the public-data API serve only the bundled dated snapshots,
# with no outbound NASA/NOAA requests. Useful for offline demos and CI.
OFFLINE=0
