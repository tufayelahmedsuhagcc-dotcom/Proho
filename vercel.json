{
  "buildCommand": "npm run build",
  "outputDirectory": "web",
  "framework": "vite",
  "functions": {
    "api/feeds.mjs": { "includeFiles": "public/data/**", "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/:path*", "destination": "/index.html" },
    { "source": "/methodology", "destination": "/index.html" },
    { "source": "/limitations", "destination": "/index.html" },
    { "source": "/data-sources", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" }
  ]
}
